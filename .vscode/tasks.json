{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Auto Version Bump (Clean)",
            "type": "shell",
            "command": "python3",
            "args": [
                "clean_version_bump.py",
                "--clean-bump",
                "--root",
                "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Initialize All File Headers",
            "type": "shell",
            "command": "python3",
            "args": [
                "tools/header_version.py",
                "apply",
                "--daycount-mode",
                "--root",
                "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
