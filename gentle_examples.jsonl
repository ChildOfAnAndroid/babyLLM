import sys
from math import sqrt
def main():
    import sys
    input = sys.stdin.read().split()
    ptr = 0
    T = int(input[ptr])
    ptr +=1
    for _ in range(T):
        # Read original triangle sides
        a = float(input[ptr])
        b = float(input[ptr+1])
        c = float(input[ptr+2])
        ptr +=3
        # Read number of points
        n = int(input[ptr])
        ptr +=1
        # Read n points
        points = []
        for _ in range(n):
            x = float(input[ptr])
            y = float(input[ptr+1])
            z = float(input[ptr+2])
            points.append( (x, y, z) )
            ptr +=3
        # Now search for the triplet
        found = False
        for i in range(n):
            for j in range(n):
                if j == i:
                    continue
                for k in range(n):
                    if k == i or k == j:
                        continue
                    # compute distances
                    # QR is distance between j and k
                    pj = points[j]
                    pk = points[k]
                    dx = pj[0] - pk[0]
                    dy = pj[1] - pk[1]
                    dz = pj[2] - pk[2]
                    QR = sqrt(dx**2 + dy**2 + dz**2)
                    # RP is distance between k and i
                    pi = points[i]
                    dx = pk[0] - pi[0]
                    dy = pk[1] - pi[1]
                    dz = pk[2] - pi[2]
                    RP = sqrt(dx**2 + dy**2 + dz**2)
                    # PQ is distance between i and j
                    dx = pi[0] - pj[0]
                    dy = pi[1] - pj[1]
                    dz = pi[2] - pj[2]
                    PQ = sqrt(dx**2 + dy**2 + dz**2)
                    # compute ratios
                    r1 = QR / a
                    r2 = RP / b
                    r3 = PQ / c
                    # check all pairs
