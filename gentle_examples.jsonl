import sys
from fractions import Fraction
from math import gcd
def lcm(a, b):
    return a * b // gcd(a, b)
def lcm_list(numbers):
    if not numbers:
        return 1
    current = numbers[0]
    for num in numbers[1:]:
        current = lcm(current, num)
    return current
def main():
    import sys
    input = sys.stdin.read().split()
    ptr = 0
    T = int(input[ptr])
    ptr +=1
    for _ in range(T):
        N = int(input[ptr])
        ptr +=1
        patterns = []
        for __ in range(N):
            patterns.append( input[ptr] )
            ptr +=1
        events = []
        denominators = set()
        for ri in patterns:
            ri_len = len(ri)
            k_old = ri_len // 2
            if k_old ==0:
                # but according to input constraints, each pattern is at least one chord. So len >=2.
                # so no need to handle.
            chords = [ ri[i:i+2] for i in range(0, ri_len, 2) ]
            for m_old in range(k_old):
                chord = chords[m_old]
                if chord == '00':
                    continue
                # process event
                value = int(chord, 16)
                # compute fraction m_old /k_old
                f = Fraction(m_old, k_old)
                denominators.add(f.denominator)
                events.append( (m_old, k_old, value) )
        if not events:
            print('00')
            continue
        # compute LCM of denominators
        denoms = list(denominators)
        new_k = lcm_list(denoms)
        # create sums
        sums = [0] * new_k
        for (m_old, k_old, value) in events:
            scale = new_k // k_old
            m_new = m_old * scale
            sums[m_new] += value
        # build new pattern
        new_pattern = ''.join( \%02X\ % s for s in sums )
        if len(new_pattern) > 2048:
            print(\Too complex.\)
        else:
            print(new_pattern)
if __name__ == '__main__':
    main()
