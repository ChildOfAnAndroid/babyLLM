So, the code:
import bisect
n = int(input())
s = list(map(int, input().split()))
s.sort()
distinct_count = 1
for i in range(1, n):
    if s[i] != s[i-1]:
        distinct_count +=1
gaps = []
for i in range(n-1):
    gaps.append(s[i+1] - s[i])
gaps.sort()
prefix = [0]*(len(gaps)+1)
for i in range(len(gaps)):
    prefix[i+1] = prefix[i] + gaps[i]
q = int(input())
output = []
for _ in range(q):
    l, r = map(int, input().split())
    if l == r:
        output.append(str(distinct_count))
    else:
        K = r - l
        pos = bisect.bisect_right(gaps, K)
        sum_overlap = (K+1)*pos - prefix[pos]
        total = n*(K+1) - sum_overlap
        output.append(str(total))
print(' '.join(output))
