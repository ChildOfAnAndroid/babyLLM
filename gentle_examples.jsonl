import math
def modinv(a, m):    g, x, y = extended_gcd(a, m)    if g != 1:        return None    else:        return x % m
def extended_gcd(a, b):    if a == 0:        return (b, 0, 1)    else:        g, y, x = extended_gcd(b % a, a)        return (g, x - (b // a) * y, y)
